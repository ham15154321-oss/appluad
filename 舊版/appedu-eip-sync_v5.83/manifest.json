{
  "manifest_version": 3,
  "name": "Appedu EIP 激勵同步",
  "version": "5.83",
  "description": "從赫綵 EIP 系統同步業績數據到激勵排行榜 — v5.83：需補件多送客戶姓名、要補什麼、補件回覆；v5.82：一天一次；v5.79：點工具列圖示就檢查新版、自動更新",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://eip.appedu.com.tw/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://start-a-new-quest-41.lovable.app/*"
      ],
      "js": [
        "pili.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EIP 激勵同步"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}